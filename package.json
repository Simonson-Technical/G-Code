{
  "name": "g-code-multi-channel",
  "displayName": "G-Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage: g-code",
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "g-code",
        "aliases": [
          "G-Code"
        ],
        "extensions": [
          ".nc",
          ".ncf",
          ".prg",
          ".txt",
          ".min",
          ".ssb"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "G-Code",
      "properties": {
        "g-code.splitMarker": {
          "type": "string",
          "default": "\\$[2-3]",
          "description": "Regex pattern for splitting into multiple channels."
        },
        "g-code.fileExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".nc",
            ".ncf",
            ".prg"
          ],
          "description": "File extensions this extension should operate on."
        },
        "g-code.syncPattern": {
          "type": "string",
          "default": "(![1-3]?)+L\\d+",
          "description": "Regex pattern for channel synchronization."
        },
        "g-code.channelLabels": {
          "type": "object",
          "description": "Maps a channel/stream number to its wait-code regex pattern.",
          "additionalProperties": {
            "type": "string"
          },
          "default": {
            "1": "!1",
            "2": "!2",
            "3": "!3"
          }
        }
      }
    },
    "configurationDefaults": {
      "[g-code]": {
        "editor.comments.insertSpace": false,
        "editor.colorDecorators": false,
        "editor.defaultColorDecorators": "never"
      },
      "editor.tokenColorCustomizations": {
        "[*]": {
          "textMateRules": [
            {
              "scope": "source.g-code",
              "settings": {
                "foreground": "#D4D4D4"
              }
            },
            {
              "scope": "comment.block.g-code",
              "settings": {
                "foreground": "#7F848E"
              }
            },
            {
              "scope": "x-axis.g-code",
              "settings": {
                "foreground": "#61AFEF"
              }
            },
            {
              "scope": "y-axis.g-code",
              "settings": {
                "foreground": "#E5C07B"
              }
            },
            {
              "scope": "z-axis.g-code",
              "settings": {
                "foreground": "#E06C75"
              }
            },
            {
              "scope": "b-axis.g-code",
              "settings": {
                "foreground": "#56B6C2"
              }
            },
            {
              "scope": "a-axis.g-code",
              "settings": {
                "foreground": "#D9648F"
              }
            },
            {
              "scope": "c-axis.g-code",
              "settings": {
                "foreground": "#98C379"
              }
            },
            {
              "scope": "radius.g-code",
              "settings": {
                "foreground": "#E88AB8"
              }
            },
            {
              "scope": "radI.g-code",
              "settings": {
                "foreground": "#4B8BD6"
              }
            },
            {
              "scope": "radJ.g-code",
              "settings": {
                "foreground": "#D4A349"
              }
            },
            {
              "scope": "radK.g-code",
              "settings": {
                "foreground": "#C8505B"
              }
            },
            {
              "scope": "gcode.g-code",
              "settings": {
                "foreground": "#9DB686"
              }
            },
            {
              "scope": "mcode.g-code",
              "settings": {
                "foreground": "#A9A1E8"
              }
            },
            {
              "scope": "tool.g-code",
              "settings": {
                "foreground": "#D4D4D4"
              }
            },
            {
              "scope": "spindle.g-code",
              "settings": {
                "foreground": "#C4A484"
              }
            },
            {
              "scope": "feedrate.g-code",
              "settings": {
                "foreground": "#C4A484"
              }
            },
            {
              "scope": "rapid.g-code",
              "settings": {
                "foreground": "#E8403A"
              }
            },
            {
              "scope": "linear.g-code",
              "settings": {
                "foreground": "#2FD65A"
              }
            },
            {
              "scope": "arcCW.g-code",
              "settings": {
                "foreground": "#F5D327"
              }
            },
            {
              "scope": "arcCCW.g-code",
              "settings": {
                "foreground": "#1E8CFF"
              }
            }
          ]
        }
      }
    },
    "commands": [
      {
        "command": "g-code.syncView",
        "title": "G-Code: Enable Sync View",
        "icon": "$(book)"
      },
      {
        "command": "g-code.channelSyncOn",
        "title": "G-Code: Enable Sync Code Matching",
        "icon": "$(eye)"
      },
      {
        "command": "g-code.channelSyncOff",
        "title": "G-Code: Disable Sync Code Matching",
        "icon": "$(eye-closed)"
      }
    ],
    "grammars": [
      {
        "language": "g-code",
        "scopeName": "source.g-code",
        "path": "./syntaxes/g-code.tmLanguage.json"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "g-code.syncView",
          "when": "editorLangId == g-code",
          "group": "navigation"
        },
        {
          "command": "g-code.channelSyncOn",
          "when": "editorLangId == g-code && !g-code.syncCodeMatchEnabled",
          "group": "navigation"
        },
        {
          "command": "g-code.channelSyncOff",
          "when": "editorLangId == g-code && g-code.syncCodeMatchEnabled",
          "group": "navigation"
        }
      ]
    }
  },
  "description": "G-Code Extension for Multichannel CNC Machines",
  "main": "./out/extension.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -p ./"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/vscode": "^1.137.0",
    "knip": "^6.39.0",
    "typescript": "^7.0.2"
  }
}
