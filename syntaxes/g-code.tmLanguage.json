{
  "scopeName": "source.g-code",
  "patterns": [
    { "include": "#x-axis" },
    { "include": "#y-axis" },
    { "include": "#z-axis" },
    { "include": "#a-axis" },
    { "include": "#b-axis" },
    { "include": "#c-axis" },
    { "include": "#radius" },
    { "include": "#radI" },
    { "include": "#radJ" },
    { "include": "#radK" },
    { "include": "#gcode" },
    { "include": "#mcode" },
    { "include": "#tool" },
    { "include": "#spindle" },
    { "include": "#feedrate" },
    { "include": "#comment" }
  ],
  "repository": {
    "comment": {
      "match": "\\(.*?\\)",
      "name": "comment.block.g-code"
    },
    "x-axis": {
      "match": "[xXuU][-]?(\\d+(?:\\.\\d+)?|\\.\\d+)?",
      "name": "x-axis.g-code"
    },
    "y-axis": {
      "match": "[yYvV][-]?(\\d+(?:\\.\\d+)?|\\.\\d+)?",
      "name": "y-axis.g-code"
    },
    "z-axis": {
      "match": "[zZwW][-]?(\\d+(?:\\.\\d+)?|\\.\\d+)?",
      "name": "z-axis.g-code"
    },
    "a-axis": {
      "match": "[aA][-]?(\\d+(?:\\.\\d+)?|\\.\\d+)?",
      "name": "a-axis.g-code"
    },
    "b-axis": {
      "match": "[bB][-]?(\\d+(?:\\.\\d+)?|\\.\\d+)?",
      "name": "b-axis.g-code"
    },
    "c-axis": {
      "match": "[cChH][-]?(\\d+(?:\\.\\d+)?|\\.\\d+)?",
      "name": "c-axis.g-code"
    },
    "radius": {
      "match": "[rR][-]?(\\d+(?:\\.\\d+)?|\\.\\d+)?",
      "name": "radius.g-code"
    },
    "radI": {
      "match": "[iI][-]?(\\d+(?:\\.\\d+)?|\\.\\d+)?",
      "name": "radI.g-code"
    },
    "radJ": {
      "match": "[jJ][-]?(\\d+(?:\\.\\d+)?|\\.\\d+)?",
      "name": "radJ.g-code"
    },
    "radK": {
      "match": "[kK][-]?(\\d+(?:\\.\\d+)?|\\.\\d+)?",
      "name": "radK.g-code"
    },
    "gcode": {
      "match": "[gG]\\d+(?:\\.\\d+)?",
      "name": "gcode.g-code"
    },
    "mcode": {
      "match": "[mM]\\d+(?:\\.\\d+)?",
      "name": "mcode.g-code"
    },
    "tool": {
      "match": "[tT]\\d+",
      "name": "tool.g-code"
    },
    "spindle": {
      "match": "[sS](\\d+)?(=\\d+)?",
      "name": "spindle.g-code"
    },
    "feedrate": {
      "match": "[fF](\\d+(?:\\.\\d+)?|\\.\\d+)?",
      "name": "feedrate.g-code"
    }
  }
}
